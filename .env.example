# start.sh が Keychain から自動で export するので、通常このファイルは使わない。
# 手動起動する場合のみ .env にコピーして値を入れる。

# main_bot.py / transcriber.py 共通 (プロセスごとに違うトークンを渡す)
DISCORD_TOKEN=

# transcriber.py: 担当セッション (lt / g1..g6)
EI_SESSION=lt

# 文字起こし
SONIOX_API_KEY=

# フィラー除去
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
POLISH_ENABLED=true

# サマライズ (OpenRouter / DeepSeek)
OPENROUTER_API_KEY=
INSIGHT_MODEL=deepseek/deepseek-v4-pro

# 外部イベントDB (友人のevent-db API)。キー未設定なら送信しない
EVENTDB_API_KEY=
EVENTDB_BASE_URL=https://event-db.varet.workers.dev/api
EVENTDB_ENABLED=true

# オーバーレイ
OVERLAY_HOST=127.0.0.1
OVERLAY_PORT=8765
